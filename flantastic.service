[Unit]
Description=flantastic — tart VM control web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and WorkingDirectory to match your install.
User=flantastic
WorkingDirectory=/opt/flantastic
ExecStart=/usr/bin/node /opt/flantastic/server.js
Restart=on-failure
RestartSec=5

# --- Configuration -------------------------------------------------------
Environment=HOST=0.0.0.0
Environment=PORT=8080
Environment=SERVERS_FILE=/opt/flantastic/servers.json
# Strongly recommended when bound to 0.0.0.0:
# Environment=AUTH_USER=admin
# Environment=AUTH_PASSWORD=change-me
# If your SSH key needs the agent instead of a key file:
# Environment=SSH_AUTH_SOCK=/run/user/1000/keyring/ssh

[Install]
WantedBy=multi-user.target
